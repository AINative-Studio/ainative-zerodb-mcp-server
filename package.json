{
  "name": "ainative-zerodb-mcp-server",
  "version": "2.5.2",
  "mcpName": "io.github.urbantech/ainative-zerodb-mcp-server",
  "description": "AINative ZeroDB MCP Server - 93 operations for vector search, TurboQuant vector compression (PolarQuant + QJL), NoSQL, dedicated PostgreSQL management, files, events, RLHF, knowledge graph (entities, edges, traversal, GraphRAG, ontology CRUD, contradictions, centrality, export), and persistent memory for AI agents with enterprise security. All tools annotated with readOnly/destructive/idempotent hints per MCP spec 2025-03-26. Production-ready MCP integration for AI assistants.",
  "main": "index.js",
  "type": "commonjs",
  "bin": {
    "ainative-zerodb-mcp": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":90,\"functions\":82,\"lines\":90,\"statements\":90}}' --forceExit",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --ci --maxWorkers=2",
    "lint": "eslint *.js __tests__/**/*.js",
    "lint:fix": "eslint *.js __tests__/**/*.js --fix",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "prepublishOnly": "npm run lint && npm test && npm run security:audit",
    "version": "npm run test && git add -A",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "zerodb",
    "ainative",
    "vector-search",
    "semantic-search",
    "embeddings",
    "rag",
    "persistence",
    "memory",
    "agent-memory",
    "database",
    "postgresql",
    "llm",
    "ai",
    "chatbot",
    "claude",
    "claude-desktop",
    "claude-code",
    "agent",
    "typescript",
    "local-first",
    "context-window",
    "conversation-history",
    "knowledge-base",
    "mcp-tools",
    "windsurf",
    "security",
    "enterprise",
    "openai",
    "ada-002",
    "text-embedding",
    "1536-dimensions",
    "automatic-token-renewal",
    "session-management",
    "namespace-isolation",
    "knowledge-graph",
    "graphrag",
    "graph-rag",
    "entity-graph",
    "graph-database",
    "ontology",
    "graph-traversal",
    "multi-hop-reasoning"
  ],
  "author": {
    "name": "AINative Studio",
    "email": "support@ainative.studio",
    "url": "https://ainative.studio"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINative-Studio/ainative-zerodb-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/AINative-Studio/ainative-zerodb-mcp-server/issues"
  },
  "homepage": "https://ainative.studio/products/zerodb",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ainative-design-system-mcp-server": "^1.0.1",
    "ainative-zerodb-mcp-server": "^2.2.0",
    "axios": "1.21.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "8.57.1",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "6.6.0",
    "jest": "30.5.2",
    "nock": "13.5.6"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/changelog/CHANGELOG.md",
    "docs/migrations/v1-to-v2-tool-naming.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "index.js",
      "!node_modules/**",
      "!coverage/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true
  }
}
